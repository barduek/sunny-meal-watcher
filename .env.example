# Copiar a .env.local para usarlo. Estas variables se leen al compilar (npm run build).

# Servidor o CDN donde están los datos de edificios. Si no se define, salen del mismo
# sitio que la app (carpeta data/). Subir public/data/ tal cual a esa dirección:
#   <esta URL>/data/palermo/index.json
#   <esta URL>/data/palermo/tiles/*.geojson
# El servidor tiene que permitir CORS para el sitio de la app (Access-Control-Allow-Origin).
# VITE_DATA_BASE_URL=https://datos.ejemplo.com/sunny-meal-watcher/
